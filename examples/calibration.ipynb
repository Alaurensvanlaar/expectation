    "def rolling_garch(series, window=50):\n",
    "    \"\"\"_summary_\n",
    "\n",
    "    Args:\n",
    "        series (_type_): simulated y series\n",
    "        window (int, optional): initial number of observation used to estimate mode. Defaults to 50.\n",
    "\n",
    "    Returns:\n",
    "        forecast: 1-day ahead forecast [mean,variance]\n",
    "        params: list of the parameter estimates \n",
    "    \"\"\"    \n",
    "    \n",
    "    forecasts = []\n",
    "    params = []\n",
    "\n",
    "    for i in range(window, len(series)):\n",
    "        y = series.iloc[i-window:i]['y']\n",
    "\n",
    "        # Assume that the modeller chose to model the DPG by: (this assumption might be a bit harsh but for the sake example consider it to be true)\n",
    "        mod = arch_model(y= y,mean='constant', lags=0, vol='GARCH', p=1, q=1, dist='normal')   \n",
    "        \n",
    "        res = mod.fit(disp=\"off\")\n",
    "        fcast =  np.concatenate([res.forecast(horizon=1).mean.values, np.sqrt(res.forecast(horizon=1).variance.values)],axis=1) \n",
    "        forecasts.append(fcast)\n",
    "        params.append(res.params.values)\n",
    "\n",
    "    forecasts = np.concatenate(forecasts,axis=0)\n",
    "    return forecasts, params\n",
    "\n",
    "roll = rolling_garch(sim,window=50)\n"
   ]
  },
