    "def plot_pit_hist(ax, idx, pit_beta_test, pit_kernel_test=None):\n",
    "    x = np.linspace(-0.05, 1.05, num=500)\n",
    "    # Histogram of PIT values up to idx\n",
    "    ax.hist(\n",
    "        pit_beta_test.z[:idx],\n",
    "        bins=20,\n",
    "        density=True,\n",
    "        alpha=0.7,\n",
    "        color=\"grey\",\n",
    "        label=\"Z\"\n",
    "    )\n",
    "    \n",
    "    # Beta density curve\n",
    "    a = pit_beta_test.epit.sequential_params[idx, 0]\n",
    "    b = pit_beta_test.epit.sequential_params[idx, 1]\n",
    "    ax.plot(x, beta.pdf(x, a=a, b=b), color=\"blue\", label=\"BetaBin(a,b)\")\n",
    "    \n",
    "    # kernel density curve\n",
    "    if pit_kernel_test is not None:\n",
    "        ax.plot(x,pit_kernel_test.epit.list_denst[idx - pit_kernel_test.epit.n0].evaluate(x),color =\"red\",label=\"kde\")\n",
    "\n",
    "    # Decorations\n",
    "    ax.grid(True, linestyle='--', color='gray', alpha=0.7)\n",
    "    ax.hlines(y=1, xmin=0, xmax=1, colors=\"black\", linestyles=\"--\", label=\"U(0,1)\")\n",
    "    ax.set_title(f\"PIT distribution at 1:{idx}\\n\"\n",
    "                 rf\"$\\alpha = {a:.3f}, \\ \\beta = {b:.3f}$\")\n",
    "    ax.set_xlabel(\"z\")\n",
    "    ax.set_ylabel(\"density\")\n",
    "    ax.legend()\n",
    "\n",
    "idx_list = np.linspace(start=pit_beta_test.epit.n0, stop=pit_beta_test.epit.n-1,num=4,dtype=int)\n",
    "idx_list = [90,150,250,350]\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "\n",
    "for ax, idx in zip(axes.ravel(), idx_list):\n",
    "    plot_pit_hist(ax, idx, pit_beta_test)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
