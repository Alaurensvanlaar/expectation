    "# --- Example 2: Simulate DGP: with indexes {1,2, ..., 250, 501, 502,...,750} being AR(1)-GARCH(1,1) and indexes {251, 252,..., 500} AR(1)-GARCH(2,2) ---\n",
    "\n",
    "T = 250\n",
    "\n",
    "from arch import arch_model\n",
    "# --- Parameters mean model ---\n",
    "mu   = 0\n",
    "phi  = 0.8\n",
    "\n",
    "# Stationary GARCH(1,1)\n",
    "omega  = 0.1\n",
    "alpha1 = 0.15\n",
    "beta1  = 0.3   # alpha1 + beta1 = 0.45 < 1\n",
    "\n",
    "# Stationary GARCH(2,2)\n",
    "omega2  = 0.1\n",
    "alpha1_2 = 0.07\n",
    "alpha2_2 = 0.07\n",
    "beta1_2  = 0.3\n",
    "beta2_2  = 0.3   # sum = 0.74 < 1\n",
    "\n",
    "# Note that the True DGP changes parameters over time \n",
    "\n",
    "# --- 1. AR(1)-GARCH(1,1) ---\n",
    "am_g11 = arch_model(\n",
    "    y=None,\n",
    "    mean=\"AR\", lags=1,\n",
    "    vol=\"GARCH\", p=1, q=1,\n",
    "    dist=\"normal\"\n",
    ")\n",
    "\n",
    "params_g11 = np.array([mu, phi, omega, alpha1, beta1])\n",
    "\n",
    "sim1 = am_g11.simulate(params_g11, nobs=T, burn=500)\n",
    "sim3 = am_g11.simulate(params_g11, nobs=T, burn=500)\n",
    "\n",
    "# --- 2. AR(0)-GARCH(2,2) ---\n",
    "\n",
    "am_g22 = arch_model(\n",
    "    y=None,\n",
    "    mean=\"AR\", lags=1,\n",
    "    vol=\"GARCH\", p=2, q=2,\n",
    "    dist=\"normal\"\n",
    ")\n",
    "\n",
    "# change also the phi parameter in the mean model\n",
    "phi  = 0.2\n",
    "\n",
    "# parameter order: [mu,  omega, alpha[1], alpha[2], beta[1], beta[2]]\n",
    "params_g22 = np.array([mu,phi, omega2, alpha1_2, alpha2_2, beta1_2, beta2_2])\n",
    "\n",
    "sim2 = am_g22.simulate(params_g22, nobs=T, burn=500)\n",
    "\n",
    "\n",
    "\n",
    "# --- Combine into one series: n + n + n observations ---\n",
    "sim = pd.concat([sim1,sim2,sim3], axis=0)\n",
    "sim.index = range(1, len(sim)+1)\n",
    "sim.columns = ['y','volatility','errors']\n",
    "sim.head()"
